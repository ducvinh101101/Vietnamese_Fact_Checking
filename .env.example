# Chỉ cần khi bật lớp giải thích bằng API ở giai đoạn sau.
# OPENAI_API_KEY=

# Template only. Copy locally if needed; never put a real key in this file.
# app.py và các script tự nạp .env (src/system_builder.load_dotenv); biến môi trường đã đặt được ưu tiên.
TAVILY_API_KEY=

# So sánh verifier với Gemini: scripts/run_model_gold.py --backend gemini
# Lấy key tại https://aistudio.google.com/apikey ; chỉ điền key thật trong .env.
GEMINI_API_KEY=
# Điền model ID có quyền truy cập trong tài khoản (xem docs Google tại ngày chạy).
GEMINI_MODEL=
