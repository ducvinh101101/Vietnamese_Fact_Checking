*.joblib filter=lfs diff=lfs merge=lfs -text
*.jar filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.xz filter=lfs diff=lfs merge=lfs -text

# Tệp có hash SHA-256 ghi trong manifest phải giữ nguyên byte trên mọi máy. Không để Git
# trên Windows (core.autocrlf=true) đổi LF -> CRLF khi checkout, nếu không validator
# W3-07 / protocol retrieval báo sai hash dù nội dung không đổi.
data/evidence/*.jsonl text eol=lf
data/evidence/*.json text eol=lf
data/evaluation/*.jsonl text eol=lf
data/evaluation/*.json text eol=lf
configs/*.yaml text eol=lf
tests/golden/model_comparison_v1/* text eol=lf
